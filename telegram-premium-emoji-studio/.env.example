# ============================================================================
# Telegram Premium Emoji Studio — environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ============================================================================

# --- Telegram (REQUIRED) ---------------------------------------------------
# Bot token from @BotFather. Used ONLY server-side (validate initData + Bot API).
BOT_TOKEN=
# Your bot's @username WITHOUT the @ (e.g. MyEmojiBot). Used for referral links.
BOT_USERNAME=
# Comma-separated admin Telegram user IDs, e.g. 111111111,222222222
ADMIN_IDS=
# Log channel id (optional). Numeric, e.g. -1001234567890
LOG_CHAT_ID=0
# Public URL where the Mini App frontend is served (used in referral links).
WEBAPP_URL=https://your-domain.com

# --- Security (REQUIRED) ---------------------------------------------------
# Long random string. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# NOTE: the first 32 chars are also used as the Telegram webhook secret_token.
SECRET_KEY=
# How long an issued session token stays valid (seconds).
AUTH_TTL_SECONDS=86400
# Max accepted age of Telegram initData (seconds).
INITDATA_MAX_AGE_SECONDS=86400

# --- Database --------------------------------------------------------------
# SQLite (default, zero-config):
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL (production) example:
# DATABASE_URL=postgresql+asyncpg://emoji:emoji@db:5432/emoji

# --- App -------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
# Comma-separated allowed origins for CORS ("*" for any).
CORS_ORIGINS=https://your-domain.com

# --- Rendering -------------------------------------------------------------
RENDER_MAX_CONCURRENCY=2
PREVIEW_WATERMARK=true

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_PREVIEW_PER_MIN=20
RATE_LIMIT_DEFAULT_PER_MIN=120

# --- Business defaults (used only until you set prices in the admin panel) --
DEFAULT_PRICE_STARS=15
DEFAULT_CODE_PRICE_STARS=5000
DEFAULT_PF_PRICE_STARS=10
DEFAULT_SUPPORT_CONTACT=@your_support_username
GIFT_MIN_AMOUNT=1
GIFT_MAX_AMOUNT=100000

# --- Text limits (mirror the original engine) ------------------------------
NAME_MAX_LEN=12
PF_MAX_LEN=5
